#include <LiquidCrystal_I2C.h>
#include <Wire.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

const int Buton1 = 2;
const int Buton2 = 3;
const int Buton3 = 4;

const int Led1 = 8;
const int Led2 = 9;
const int Led3 = 10;

int etajCurent = 1;

void aprindeEtaj(int etaj) {
  digitalWrite(Led1, etaj == 1);
  digitalWrite(Led2, etaj == 2);
  digitalWrite(Led3, etaj == 3);
}

void afisare(int etaj, String directie) {
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Etaj: ");
  lcd.print(etaj);

  lcd.setCursor(0, 1);
  lcd.print("Directie: ");
  lcd.print(directie);

  Serial.print("Etaj: ");
  Serial.println(etaj);

  Serial.print("Directie: ");
  Serial.println(directie);
}

void mergiLaEtaj(int etajNou) {

  if (etajNou == etajCurent)
    return;

  String directie;

  if (etajNou > etajCurent)
    directie = "Sus";
  else
    directie = "Jos";

  while (etajCurent != etajNou) {

    afisare(etajCurent, directie);

    delay(2000);

    if (etajNou > etajCurent)
      etajCurent++;
    else
      etajCurent--;

    aprindeEtaj(etajCurent);
  }

  afisare(etajCurent, "---");
}

void setup() {

  pinMode(Buton1, INPUT_PULLUP);
  pinMode(Buton2, INPUT_PULLUP);
  pinMode(Buton3, INPUT_PULLUP);

  pinMode(Led1, OUTPUT);
  pinMode(Led2, OUTPUT);
  pinMode(Led3, OUTPUT);

  Serial.begin(9600);

  lcd.init();
  lcd.backlight();

  aprindeEtaj(1);
  afisare(1, "---");
}

void loop() {

  if (digitalRead(Buton1) == LOW) {
    mergiLaEtaj(1);
  }

  if (digitalRead(Buton2) == LOW) {
    mergiLaEtaj(2);
  }

  if (digitalRead(Buton3) == LOW) {
    mergiLaEtaj(3);
  }
}
