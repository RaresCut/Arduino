#define PLAYER_WAIT_TIME 5000

int sequence[100];
int curLen = 0;
int inputCount = 0;
int lastInput = 0;
int expRd = 0;
bool btnDwn = false;
bool wait = false;
bool resetFlag = false;

const int noPins = 4;
const int pins[] = {5, 7, 9, 11};
                              
long inputTime = 0;

void setup() {
  delay(3000);                
  Serial.begin(9600);         
  Reset();
}

// Sets all game pins as either INPUT or OUTPUT
void setPinDirection(int dir){
  for(int i = 0; i < noPins; i++){
    pinMode(pins[i], dir); 
  }
}

// Sends the same state (HIGH/LOW) to all game pins
void writeAllPins(int val){
  for(int i = 0; i < noPins; i++){
    digitalWrite(pins[i], val); 
  }
}

// Flashes all LEDs simultaneously at a given frequency
void flash(int freq){
  setPinDirection(OUTPUT);  
  for(int i = 0; i < 3; i++){
    writeAllPins(HIGH);
    delay(freq);
    writeAllPins(LOW);
    delay(freq);
  }
}

// Resets all game variables to start a new game
void Reset(){
  flash(500);
  curLen = 0;
  inputCount = 0;
  lastInput = 0;
  expRd = 0;
  btnDwn = false;
  wait = false;
  resetFlag = false;
}

void Lose(){
  flash(50);  
}

// Lights up the LEDs in order to show the player the current sequence
void playSequence(){
  for(int i = 0; i < curLen; i++){
      Serial.print("Seq: ");
      Serial.print(i);
      Serial.print("Pin: ");
      Serial.println(sequence[i]);
      
      digitalWrite(sequence[i], HIGH);
      delay(500);
      digitalWrite(sequence[i], LOW);
      delay(250);
    } 
}

// Triggers the game-over sequence, replays the final sequence, and resets
void DoLoseProcess(){
  Lose();             
  delay(1000);
  playSequence();     
  delay(1000);
  Reset();            
}

void loop() {  
  if(!wait){      
    // -------------------------
    //      ARDUINO'S TURN 
    // -------------------------
    setPinDirection(OUTPUT);                      
    
    randomSeed(analogRead(A0));                   
    sequence[curLen] = pins[random(0,noPins)];    // Append a new random pin to the sequence
    curLen++;                                     
    
    playSequence();                               
    
    wait = true;                                  // Hand turn over to the player
    inputTime = millis();                         
  } else { 
    // -------------------------
    //      PLAYER'S TURN 
    // -------------------------
    setPinDirection(INPUT);                       

    // Check for player timeout
    if(millis() - inputTime > PLAYER_WAIT_TIME){  
      DoLoseProcess();                            
      return;
    }      
        
    // Check if the player presses an incorrect button
    if(!btnDwn){                                  
      expRd = sequence[inputCount];               
      Serial.print("Expected: ");                 
      Serial.println(expRd);                      
      
      for(int i = 0; i < noPins; i++){           
        if(pins[i] == expRd)                        
          continue;                               // Skip checking the correct pin
          
        if(digitalRead(pins[i]) == HIGH){         
          lastInput = pins[i];
          resetFlag = true;                       // Flag the loss
          btnDwn = true;                          // Debounce/prevent repeated reads
          Serial.print("Read: ");                 
          Serial.println(lastInput);              
        }
      }      
    }

    // Check if the player presses the correct button
    if(digitalRead(expRd) == 1 && !btnDwn)        
    {
      inputTime = millis();                       // Reset timeout timer
      lastInput = expRd;
      inputCount++;                               
      btnDwn = true;                              
      Serial.print("Read: ");                     
      Serial.println(lastInput);                  
    } else {
      // Check if the player released the button to progress state
      if(btnDwn && digitalRead(lastInput) == LOW){  
        btnDwn = false;
        delay(20);
        
        if(resetFlag){                            // Player failed during this press
          DoLoseProcess();                        
        }
        else{
          if(inputCount == curLen){               // Player successfully completed the sequence
            wait = false;                         // Return turn to Arduino
            inputCount = 0;                       
            delay(1500);
          }
        }
      }
    }    
  }
}
